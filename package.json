{
  "name": "ai-stock-manager",
  "version": "1.0.0",
  "private": true,
  "description": "AI Stock Manager Express web application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.cjs",
    "start:env": "node --env-file=.env server.js",
    "db:check": "node scripts/central-db.cjs check",
    "db:backup": "node scripts/central-db.cjs backup"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "jsdom": "^30.1.0"
  }
}
