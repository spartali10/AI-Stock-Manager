# Copy this file to .env and fill in real values there, never in this template.
# npm start reads .env; hosting environment variables take precedence.
DATABASE_URL=
DATABASE_SSL=false
# DATABASE_CA= optional trusted CA PEM when DATABASE_SSL=true
# First setup only. Username: admin. Choose a unique 8-1024 character password.
# Existing accounts and passwords are never overwritten.
ADMIN_PASSWORD=
PORT=3000
APP_ORIGIN=http://localhost:3000
# Local development only; Render requires DATABASE_URL.
SQLITE_PATH=./data/stock-manager.sqlite
