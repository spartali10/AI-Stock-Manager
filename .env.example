# Never commit .env or actual credentials. Use Render Environment settings.
# Render production requires a PostgreSQL URL. Leave empty only for local SQLite.
DATABASE_URL=
DATABASE_SSL=false
# DATABASE_CA= optional trusted CA PEM when DATABASE_SSL=true
# Initial central admin only. Choose a unique password; no default is provided.
ADMIN_PASSWORD=
PORT=3000
# Exact public origin, without trailing slash. Set to your HTTPS URL on Render.
APP_ORIGIN=http://localhost:3000
# SQLite is local-development only. Node.js >=22.13 is required for node:sqlite.
SQLITE_PATH=./data/stock-manager.sqlite
